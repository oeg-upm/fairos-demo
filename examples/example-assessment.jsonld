        "@type": "Test"
      },
      "license": {
        "@id": "http://creativecommons.org/licenses/by/4.0/"
      },
      "title": "Metadata identifier follows a defined unique identifier syntax or scheme (IRI, URL, UUID, HASH or PID)",
      "value": "PASS",
